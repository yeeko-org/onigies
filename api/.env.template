# ─── Archivos subidos en S3 ─────────────────────────────────
# Puente temporal (~2 meses) mientras llega el servidor de la UNAM:
# los adjuntos viven en un bucket privado, sin acceso público, y se
# entregan con URLs firmadas a través del endpoint de descarga.
# Los estáticos nunca van a S3. En local se deja apagado.
# Con USE_S3_FILES=1, el bucket y la región son obligatorios (sin
# región la firma no sirve): si faltan, el arranque falla a propósito.
# USE_S3_FILES=0
# AWS_STORAGE_BUCKET_NAME=onigies-v3-temporal
# AWS_S3_REGION_NAME=
# AWS_LOCATION=files
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
